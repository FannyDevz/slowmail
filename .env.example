# Dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia, hanya untuk server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cadangan jika header Origin tidak ada (mis. https://merpati-mail.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tampilkan pilihan kecepatan simulasi di produksi (selalu aktif saat dev)
ALLOW_SIMULATION=false

# Opsional: penyedia peta dan geocoding MapTiler untuk produksi (bawaan: OpenStreetMap/Nominatim)
NEXT_PUBLIC_MAPTILER_KEY=
